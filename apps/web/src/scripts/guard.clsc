on interact(Guard) {
    play(cutscene::guard_walk);
}

// Loop and destination tiles are clear of collision/obstacle tiles and of every Zone on main_test.tmj.
// Ends on the Companion recruit choice; the Guard walks back to its post first, so "Nah" leaves it there.
cutscene guard_walk with Guard, Player, fluffy {
    Guard(Happy): "Oh! You finally came to see me~ I've been watching you ever since you arrived, you know.";
    Guard(Happy): "Come, come! Walk with me. Stay close... closer~";
    follow(Player, Guard);
    move(Guard, (9, 10));
    move(Guard, (9, 8));
    move(Guard, (6, 8));
    move(Guard, (5, 10));
    Guard(Happy): "See? We walk so well together... almost like we were made for each other.";
    Guard: "Now YOU lead. I'll be right behind you. Always. Every single step.";
    follow(Guard, Player);
    move(Player, (8, 5));
    Guard(Happy): "Hehe... I already memorised the way you walk. That's not weird. It's devotion~";
    move(Guard, (5, 11));
    Guard(Sad): "I'm supposed to stay at my post... but you wouldn't leave me here all alone. Would you?";
    choose {
        "Follow me forever" => {
            set companion[Guard] = fluffy;
        }
        "Nah, stay here";
    }
}
