{
  "name": "game-engine",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --cwd apps/web dev",
    "lint": "oxlint && bun run --filter '*' lint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxlint": "^1.83.0"
  }
}
