      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codeleagues-rpg-engine/clsc": "*",
    "@codeleagues-rpg-engine/engine-core": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "preact": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
